PORT=4000
JWT_SECRET="change-this-in-production"

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=bhatta_app
DB_PASSWORD="change-this-in-production"
DB_NAME=bhatta_cloud

# Optional: override where generated files (salary slip PDFs) are stored
# (defaults to backend/data/)
# DATA_DIR="/var/data/bhatta-cloud"

# Set this to your production domain (e.g. app.example.com) once deployed —
# allows it (and its subdomains) through CORS alongside localhost and
# *.bhattaaa.pages.dev. See src/config/env.ts.
# PRODUCTION_DOMAIN="app.example.com"
