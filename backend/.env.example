PORT=4000
JWT_SECRET="change-this-in-production"

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=bhatta_app
DB_PASSWORD="change-this-in-production"
DB_NAME=bhatta_cloud

# Optional: override where generated files (salary slip PDFs) are stored
# (defaults to backend/data/)
# DATA_DIR="/var/data/bhatta-cloud"

# Set this to your production domain (e.g. app.example.com) once deployed —
# allows it (and its subdomains) through CORS alongside localhost and
# *.bhattaaa.pages.dev. See src/config/env.ts.
# PRODUCTION_DOMAIN="app.example.com"

# Optional: WhatsApp Business Cloud API, powers the Reports page's "Send
# Text" button. Get these from a Meta developer app's WhatsApp product
# (Phone Number ID + a permanent access token). Left unset, Send Text
# responds with a clean "not configured" instead of erroring.
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# WHATSAPP_ACCESS_TOKEN="EAAG..."
